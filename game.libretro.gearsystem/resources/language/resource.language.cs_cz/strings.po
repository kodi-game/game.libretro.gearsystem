msgctxt "Addon Summary"
msgid "Sega - MS/GG/SG-1000 (Gearsystem)"
msgstr "Sega - MS/GG/SG-1000 (Gearsystem)"

msgctxt "Addon Description"
msgid "Gearsystem is an open source, cross-platform, Sega Master System / Game Gear / SG-1000 / Othello Multivision emulator."
msgstr "Gearsystem je multiplatformní open-source emulátor Sega Master System / Game Gear / SG-1000 / Othello Multivision."

msgctxt "#30001"
msgid "System (restart)"
msgstr "Systém (vyžaduje restart)"

msgctxt "#30002"
msgid "Region (restart)"
msgstr "Region (vyžaduje restart)"

msgctxt "#30003"
msgid "Mapper (restart)"
msgstr "Mapper (vyžaduje restart)"

msgctxt "#30004"
msgid "Refresh Rate (restart)"
msgstr "Obnovovací frekvence (vyžaduje restart)"

msgctxt "#30005"
msgid "Master System BIOS (restart)"
msgstr "BIOS pro Master System (vyžaduje restart)"

msgctxt "#30006"
msgid "Game Gear BIOS (restart)"
msgstr "BIOS pro Game Gear (vyžaduje restart)"

msgctxt "#30007"
msgid "3D Glasses"
msgstr "3D brýle"

msgctxt "#30008"
msgid "Allow Up+Down / Left+Right"
msgstr "Povolit nahoru+dolů / doleva+doprava"

msgctxt "#30010"
msgid "Overscan"
msgstr "Overscan"

msgctxt "#30011"
msgid "YM2413 (restart)"
msgstr "YM2413 (vyžaduje restart)"

msgctxt "#30012"
msgid "Hide Left Bar (SMS only)"
msgstr "Skrýt levý pruh (pouze SMS)"

msgctxt "#30013"
msgid "Aspect Ratio"
msgstr "Poměr stran"

msgctxt "#30014"
msgid "Light Gun Input"
msgstr "Vstup světelné pistole"

msgctxt "#30015"
msgid "Paddle Sensitivity"
msgstr "Citlivost paddle ovladače"

msgctxt "#30016"
msgid "PSG Volume"
msgstr "Hlasitost PSG"

msgctxt "#30017"
msgid "FM Volume"
msgstr "Hlasitost FM"

msgctxt "#30018"
msgid "Light Gun Crosshair"
msgstr "Zaměřovací kříž světelné pistole"

msgctxt "#30019"
msgid "Light Gun Crosshair Shape"
msgstr "Tvar zaměřovacího kříže světelné pistole"

msgctxt "#30020"
msgid "Light Gun Crosshair Color"
msgstr "Barva zaměřovacího kříže světelné pistole"

msgctxt "#30021"
msgid "Light Gun Crosshair Offset X"
msgstr "Posun zaměřovacího kříže světelné pistole v ose X"

msgctxt "#30022"
msgid "Light Gun Crosshair Offset Y"
msgstr "Posun zaměřovacího kříže světelné pistole v ose Y"

msgctxt "#30023"
msgid "No Sprite Limit"
msgstr "Bez limitu spritů"

msgctxt "#30024"
msgid "System"
msgstr "Systém"

msgctxt "#30025"
msgid "Configure system type, region, mapper, refresh rate and BIOS settings."
msgstr "Nastaví typ systému, region, mapper, obnovovací frekvenci a BIOS."

msgctxt "#30026"
msgid "Select the console type to emulate. 'Auto' automatically detects the appropriate system based on the loaded content."
msgstr "Vyberte typ emulované konzole. „Automaticky“ detekuje vhodný systém podle načteného obsahu."

msgctxt "#30027"
msgid "Select which region is emulated. 'Auto' automatically detects the appropriate region based on the loaded content."
msgstr "Vyberte emulovaný region. „Automaticky“ detekuje vhodný region podle načteného obsahu."

msgctxt "#30028"
msgid "Select which mapper (memory bank controller) is emulated. 'Auto' automatically detects the appropriate mapper based on the loaded content. Only change this if a game does not work correctly with the default setting."
msgstr "Vyberte emulovaný mapper (řadič paměťových bank). „Automaticky“ detekuje vhodný mapper podle načteného obsahu. Toto nastavení měňte pouze tehdy, když hra s výchozím nastavením nefunguje správně."

msgctxt "#30029"
msgid "Select which refresh rate will be used in emulation. 'Auto' selects the best refresh rate based on the loaded content."
msgstr "Vyberte obnovovací frekvenci použitou při emulaci. „Automaticky“ vybere nejlepší frekvenci podle načteného obsahu."

msgctxt "#30030"
msgid "Enable or disable the Master System BIOS. For this to work, the 'bios.sms' file must exist in the frontend's system directory. When enabled it will execute as in original hardware, which may cause invalid ROMs to lock or fail to boot."
msgstr "Povolí nebo zakáže BIOS Master System. Aby to fungovalo, musí v systémové složce frontendu existovat soubor „bios.sms“. Je-li povolen, provede se stejně jako na původním hardwaru, což může způsobit zablokování nebo selhání spuštění neplatných ROM."

msgctxt "#30031"
msgid "Enable or disable the Game Gear BIOS. For this to work, the 'bios.gg' file must exist in the frontend's system directory. When enabled it will execute as in original hardware, which may cause invalid ROMs to lock or fail to boot."
msgstr "Povolí nebo zakáže BIOS Game Gear. Aby to fungovalo, musí v systémové složce frontendu existovat soubor „bios.gg“. Je-li povolen, provede se stejně jako na původním hardwaru, což může způsobit zablokování nebo selhání spuštění neplatných ROM."

msgctxt "#30032"
msgid "Video"
msgstr "Video"

msgctxt "#30033"
msgid "Configure aspect ratio, overscan, left bar visibility, sprite limit and 3D glasses settings."
msgstr "Nastaví poměr stran, overscan, viditelnost levého pruhu, limit spritů a 3D brýle."

msgctxt "#30034"
msgid "Select which aspect ratio will be presented by the core. '1:1 PAR' selects an aspect ratio that produces square pixels."
msgstr "Vyberte poměr stran použitý jádrem. „1:1 PAR“ vybere poměr stran vytvářející čtvercové pixely."

msgctxt "#30035"
msgid "Select which overscan (borders) will be used in emulation. 'Top+Bottom' enables overscan for top and bottom only. 'Full' enables overscan for all sides with the specified width."
msgstr "Vyberte overscan (okraje) použitý při emulaci. „Nahoře+dole“ povolí overscan pouze nahoře a dole. „Plný“ povolí overscan na všech stranách se zadanou šířkou."

msgctxt "#30036"
msgid "Select when to hide the left column in Master System games. Some games use this column for scrolling artifacts. 'Auto' hides it only when a left bar is detected. 'Always' hides it unconditionally."
msgstr "Určuje, kdy skrýt levý sloupec ve hrách Master System. Některé hry tento sloupec používají pro artefakty posunu. „Automaticky“ ho skryje pouze při detekci levého pruhu. „Vždy“ ho skryje bez podmínky."

msgctxt "#30037"
msgid "Remove the per-line sprite limit. This reduces flickering but may cause glitches in certain games. It's best to keep this option disabled."
msgstr "Odstraní limit spritů na řádek. Tím se omezí blikání, ale v některých hrách to může způsobit chyby. Nejlepší je ponechat tuto volbu vypnutou."

msgctxt "#30038"
msgid "For games with 3D glasses support, select which eye to display. 'Both Eyes / OFF' is required for games without 3D support or to display both eyes simultaneously."
msgstr "U her s podporou 3D brýlí vyberte, které oko zobrazit. U her bez podpory 3D nebo pro současné zobrazení obou očí je nutné „Obě oči / VYPNUTO“."

msgctxt "#30039"
msgid "Audio"
msgstr "Audio"

msgctxt "#30040"
msgid "Configure FM sound chip settings."
msgstr "Nastaví zvukový čip FM."

msgctxt "#30041"
msgid "Enable or disable the YM2413 (OPLL) FM sound chip. 'Auto' enables the chip based on the loaded content. Some Master System games use this chip for enhanced music."
msgstr "Povolí nebo zakáže zvukový čip FM YM2413 (OPLL). „Automaticky“ povolí čip podle načteného obsahu. Některé hry Master System tento čip používají pro vylepšenou hudbu."

msgctxt "#30042"
msgid "Set the volume of the PSG (SN76489). The value is a percentage from 0 to 200, where 100 is the default volume."
msgstr "Nastaví hlasitost PSG (SN76489). Hodnota je procento od 0 do 200, přičemž 100 je výchozí hlasitost."

msgctxt "#30043"
msgid "Set the volume of the YM2413 (OPLL) FM sound chip. The value is a percentage from 0 to 200, where 100 is the default volume."
msgstr "Nastaví hlasitost zvukového čipu FM YM2413 (OPLL). Hodnota je procento od 0 do 200, přičemž 100 je výchozí hlasitost."

msgctxt "#30044"
msgid "Input"
msgstr "Vstup"

msgctxt "#30045"
msgid "Configure controller behavior, light gun and paddle settings."
msgstr "Nastaví chování ovladače, světelnou pistoli a paddle."

msgctxt "#30046"
msgid "Allow pressing, quickly alternating, or holding both left and right (or up and down) directions at the same time. This may cause movement based glitches in certain games."
msgstr "Umožní současné stisknutí, rychlé střídání nebo podržení směrů doleva a doprava (nebo nahoru a dolů). V některých hrách to může způsobit chyby pohybu."

msgctxt "#30047"
msgid "Select which input method will be used for Light Phaser games. 'Light Gun' uses a mouse-controlled light gun input. 'Touchscreen' uses pointer-based touchscreen input."
msgstr "Vyberte metodu vstupu pro hry Light Phaser. „Světelná pistole“ používá vstup světelné pistole ovládaný myší. „Dotyková obrazovka“ používá vstup dotykové obrazovky založený na ukazateli."

msgctxt "#30048"
msgid "Enable or disable the crosshair overlay for Light Phaser games."
msgstr "Povolí nebo zakáže překryv zaměřovacího kříže pro hry Light Phaser."

msgctxt "#30049"
msgid "Select the shape of the crosshair overlay for Light Phaser games."
msgstr "Vyberte tvar překryvu zaměřovacího kříže pro hry Light Phaser."

msgctxt "#30050"
msgid "Select the color of the crosshair overlay for Light Phaser games."
msgstr "Vyberte barvu překryvu zaměřovacího kříže pro hry Light Phaser."

msgctxt "#30051"
msgid "Set the horizontal pixel offset of the crosshair for calibration purposes."
msgstr "Nastaví vodorovný posun zaměřovacího kříže v pixelech pro účely kalibrace."

msgctxt "#30052"
msgid "Set the vertical pixel offset of the crosshair for calibration purposes."
msgstr "Nastaví svislý posun zaměřovacího kříže v pixelech pro účely kalibrace."

msgctxt "#30053"
msgid "Set the sensitivity of the Paddle Control. Higher values result in faster paddle movement."
msgstr "Nastaví citlivost ovladače Paddle Control. Vyšší hodnoty znamenají rychlejší pohyb paddle ovladače."
